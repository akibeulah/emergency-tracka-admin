# Copy to .env.local (gitignored) and adjust.

# 'mock' (default) runs entirely in the browser against example data, clearly labelled.
# 'live' talks to server/.
VITE_API_MODE=live

# Base URL of the server API, including the /api prefix.
VITE_API_URL=http://localhost:3000/api

# Live mode only: comma-separated modules to answer from the mock instead of the server
# (auth, claims, facilities, alerts). Pages label mocked data as example data.
# Leave empty to use the server for everything.
VITE_MOCK_MODULES=
